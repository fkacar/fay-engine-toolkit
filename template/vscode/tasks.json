{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Derle",
            "type": "shell",
            "command": "./run.sh build",
            "windows": {
                "command": "run.bat build",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$haxe",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "clear": true
            }
        }
    ]
}
