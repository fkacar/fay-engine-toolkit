{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "sahne-editoru",
            "tool": "file_status",
            "input": {
              "file_path": "${tool_input.file_path}",
              "hook": true
            }
          }
        ]
      }
    ]
  }
}
