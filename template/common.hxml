-cp src
libs/scene-toolkit/runtime.hxml
-lib heaps:2.1.0
-lib format:3.8.0
-lib hlsdl:1.16.0
-main Main
--macro scene.macro.SceneCheck.run("res/scenes")
--macro scene.macro.SceneCheck.run("res/prefabs")
--macro scene.macro.SceneCheck.run("res/world")
-D analyzer-optimize
-D windowSize=1280x720
-D windowTitle=Yeni Oyun
-debug
