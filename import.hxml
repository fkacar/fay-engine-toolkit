# Komut satırından içe aktarma (scene.editor.ImportMain): Asset Browser ile aynı AssetImporter, pencere açmaz.
# Windows: run.bat ice-aktar <kaynak ...> (bayt kodu); Mac: import-mac.hxml.
-cp libs/scene-toolkit/runtime
-cp libs/scene-toolkit/editor
-cp libs/scene-toolkit/third_party/hlimgui
-lib heaps
-lib format
-lib hlsdl
-D hlimgui
-D scene_editor
-main scene.editor.ImportMain
